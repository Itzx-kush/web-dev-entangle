{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "node-api": {
      "root": "node-api",
      "framework": "express",
      "installCommand": "npm ci",
      "routes": [
        {
          "src": "/api/notes/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/api/$1"
            }
          ]
        }
      ],
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/notes/(.*)",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": "https://entanglex-q-health-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
