{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "node-api": {
      "root": "node-api",
      "framework": "express",
      "installCommand": "npm ci",
      "entrypoint": "api/index.js",
      "rewrites": [
        {
          "source": "/api/notes/:path(.*)?",
          "destination": "/api/:path"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/notes/(.*)",
      "destination": {
        "service": "node-api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": "https://entanglex-q-health-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
