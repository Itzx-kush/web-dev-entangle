# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection (Persistent Experiment Notes Storage)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/entanglex?retryWrites=true&w=majority
# For local MongoDB development: mongodb://localhost:27017/entanglex
MONGODB_URI=mongodb+srv://your-db-user:your-db-password@your-cluster.mongodb.net/entanglex?retryWrites=true&w=majority

# Supabase Authentication (JWT Verification Only)
# Used to verify incoming Bearer tokens from authenticated users; never use a service-role key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
